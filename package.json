{
    "private": true,
    "scripts": {
        "build": "nuxt build",
        "clean:dsstore": "find . -name '.DS_Store' -depth -delete",
        "dev": "npm run clean:dsstore && nuxt dev",
        "dev-ssl": "NODE_TLS_REJECT_UNAUTHORIZED=0 npm run clean:dsstore && nuxt dev --https --ssl-cert localhost.pem --ssl-key localhost-key.pem",
        "generate": "nuxt generate",
        "preview": "nuxt preview",
        "postinstall": "nuxt prepare",
        "lint": "npm-run-all --parallel lint:*",
        "lint:js": "npx eslint --no-error-on-unmatched-pattern --fix {components,layouts,pages,plugins,stores,utils,test,middleware}/**/*.{js,ts,vue}",
        "lint:css": "stylelint --config ./.stylelintrc --fix \"assets/**/*.{css,scss}\"",
        "format": "npm-run-all --serial format:check format:write",
        "format:check": "npx prettier --check \"**/(*.vue|*.js|*.ts|*.md|*.scss)\"",
        "format:write": "npx prettier --write \"**/(*.vue|*.js|*.ts|*.md|*.scss)\"",
        "cf-export": "dotenv -e .env -- sh -c 'contentful space export --config contentful/export-config.json --space-id \"$CONTENTFUL_SPACE_ID\" --environment-id \"$CONTENTFUL_ENVIRONMENT_ID\" --management-token \"$CONTENTFUL_CMA_ACCESS_TOKEN\"'",
        "env:echo": "dotenv -e .env -- sh -c 'echo SPACE:$CONTENTFUL_SPACE_ID ENV:$CONTENTFUL_ENVIRONMENT_ID'",
        "cf-generate-types": "cf-content-types-generator contentful/exports/export.json --out app/types/contentful  -X",
        "cf-types": "npm run cf-export && npm run cf-generate-types"
    },
    "devDependencies": {
        "@nuxt/fonts": "^0.12.1",
        "@nuxtjs/supabase": "^1.6.2",
        "@tailwindcss/typography": "^0.5.19",
        "@types/safe-json-stringify": "^1.1.5",
        "@typescript-eslint/eslint-plugin": "8.49.0",
        "@typescript-eslint/parser": "8.49.0",
        "@vite-pwa/nuxt": "^1.1.0",
        "cf-content-types-generator": "^2.16.1",
        "dotenv-cli": "^10.0.0",
        "eslint": "^8.57.1",
        "eslint-config-prettier": "10.1.8",
        "eslint-config-standard": "17.1.0",
        "eslint-plugin-nuxt": "4.0.0",
        "eslint-plugin-prettier": "5.5.4",
        "eslint-plugin-vue": "9.33.0",
        "npm-run-all": "4.1.5",
        "nuxt": "4.2.1",
        "nuxt-viewport": "2.3.1",
        "pinia-plugin-persistedstate": "^4.7.1",
        "prettier-plugin-tailwindcss": "0.7.2",
        "stylelint": "16.26.1",
        "stylelint-config-tailwindcss": "^1.0.0",
        "typescript": "5.9.3",
        "vite-plugin-eslint": "1.8.1",
        "vue": "3.5.25",
        "vue-router": "4.6.3",
        "vue-tsc": "2.2.12"
    },
    "dependencies": {
        "@contentful/rich-text-types": "^17.2.5",
        "@nuxt/image": "1.11.0",
        "@nuxt/ui": "^4.2.1",
        "@pinia/nuxt": "0.11.3",
        "@tailwindcss/vite": "^4.1.17",
        "@vueuse/core": "^13.9.0",
        "@yeger/vue-masonry-wall": "^5.1.4",
        "contentful": "^11.9.0",
        "contentful-management": "^11.63.1",
        "contentful-rich-text-vue-renderer": "^3.2.0",
        "esbuild": "0.27.1",
        "pinia": "3.0.4",
        "serpapi": "^2.2.1",
        "stylelint-config-standard": "^39.0.1",
        "stylelint-prettier": "5.0.3",
        "tailwindcss": "^4.1.17"
    }
}
